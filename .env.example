ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the whole app (proxy.ts) — single-user, no accounts.
APP_PASSWORD=

# LLM_PROVIDER selects which provider sendToClaude() actually calls.
# "anthropic" (default, or unset) uses ANTHROPIC_API_KEY.
# "grok" uses XAI_API_KEY / XAI_MODEL instead (OpenAI-compatible xAI API).
# "groq" uses GROQ_API_KEY / GROQ_MODEL instead (OpenAI-compatible Groq API, has a free tier).
LLM_PROVIDER=anthropic
XAI_API_KEY=
XAI_MODEL=grok-4-fast
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
